diff --git a/src/client/bpmn-editor.css b/src/client/bpmn-editor.css
index 9a87ace..9c92166 100644
--- a/src/client/bpmn-editor.css
+++ b/src/client/bpmn-editor.css
@@ -5,7 +5,30 @@ html, body {
 
 body {
   color: #333;
-  background: white;
+  background: #fff;
+}
+
+/*
+ * Dark theme.
+ *
+ * Applied either explicitly (`bpmn-theme-dark`) or, in `auto` mode, whenever
+ * VS Code itself uses a dark color theme. VS Code adds `vscode-dark` to the
+ * body and keeps it in sync as the user switches themes, so `auto` follows
+ * the workbench live without any JavaScript.
+ *
+ * bpmn-js renders the diagram black-on-white. We invert luminance while
+ * preserving hue (`hue-rotate(180deg)`) so user-defined element colors stay
+ * recognizable and the popup/search menus darken for free.
+ */
+body.bpmn-theme-dark,
+body.vscode-dark.bpmn-theme-auto {
+  color: #ccc;
+  background: #1e1e1e;
+}
+
+body.bpmn-theme-dark #canvas,
+body.vscode-dark.bpmn-theme-auto #canvas {
+  filter: invert(1) hue-rotate(180deg);
 }
 
 #canvas {
diff --git a/src/client/bpmn-editor.js b/src/client/bpmn-editor.js
index 4492a2d..b3ff89f 100644
--- a/src/client/bpmn-editor.js
+++ b/src/client/bpmn-editor.js
@@ -104,8 +104,28 @@ window.addEventListener('message', async (event) => {
   case 'focusCanvas':
     modeler.get('canvas').focus();
     return;
+
+  case 'theme':
+    applyTheme(body.theme);
+    return;
   }
 });
 
+/**
+ * Apply the configured diagram theme by toggling the `bpmn-theme-*` class on
+ * the body. Other classes (e.g. VS Code's `vscode-dark`/`vscode-light`) are
+ * preserved so `auto` keeps following the workbench theme.
+ *
+ * @param {string} theme one of 'auto', 'light', 'dark'
+ */
+function applyTheme(theme) {
+  document.body.classList.remove(
+    'bpmn-theme-auto',
+    'bpmn-theme-light',
+    'bpmn-theme-dark'
+  );
+  document.body.classList.add(`bpmn-theme-${theme}`);
+}
+
 // signal to VS Code that the webview is initialized
 vscode.postMessage({ type: 'ready' });
